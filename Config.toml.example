# Command to execute the server. With port 1, %p selects the SliM stdin/stdout transport.
execute_server_command = "cargo run --example calculator %p"
# SliM reserves port 1 for communication over the child process's stdin/stdout.
port = 1
# The TCP connection pool is unused for port 1; keep one logical server slot.
pool_size = 1
# Dir with markdown files to be tested
test_dir = "temoc/examples/"
# File extensions to filter for markdowns. Default is "md". Not case sensitive
extension = "md"
# If we should traverse the test dir recursively
recursive = true
# Show snoozed errors
show_snoozed = true
# Pipe STDOUT and STDERR of the slim server through the STDOUT of the application
pipe_output = true
